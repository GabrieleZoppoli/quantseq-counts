// Arguments of each tool: those executed in the reference run (nf-core/rnaseq 3.26.0, the tasks' .command.sh files),
// apart from the removals (no transcriptome output, no Salmon) and the new name-then-position sort. Every value that a user may change
// comes from a setting (settings.yaml); the rest is fixed here.
process {
    publishDir = [ enabled: false ]

    withName: 'FQ_LINT|FQ_LINT_AFTER_TRIMMING' {
        ext.args   = '--disable-validator P001'
        publishDir = [ path: { "${params.outdir}/qc/fq_lint" }, mode: 'copy', pattern: '*.txt' ]
    }
    withName: 'FQ_LINT_AFTER_TRIMMING' { ext.prefix = { "${meta.id}.trimmed" } }
    withName: 'FASTQC' {
        ext.args   = '--quiet'
        ext.prefix = { "${meta.id}_raw" }
        publishDir = [ path: { "${params.outdir}/qc/fastqc" }, mode: 'copy', pattern: '*.{html,zip}' ]
    }
    withName: 'UMITOOLS_EXTRACT' {
        ext.args   = { "--extract-method=regex --bc-pattern='${params.umi_pattern}'" }
        publishDir = [ path: { "${params.outdir}/qc/umitools" }, mode: 'copy', pattern: '*.log' ]
    }
    withName: 'TRIMGALORE' {
        ext.args   = { "--fastqc_args '-t ${task.cpus}' --adapter ${params.trim_adapter}" }
        ext.prefix = { "${meta.id}_trimmed" }
        publishDir = [
            [ path: { "${params.outdir}/qc/trimgalore" }, mode: 'copy', pattern: '*.{txt,html,zip}' ],
            [ path: { "${params.outdir}/run/intermediate" }, mode: 'copy', pattern: '*.fq.gz', enabled: params.keep_trimmed_fastq ]
        ]
    }
    withName: 'STAR_ALIGN' {
        cpus     = { params.star_threads ?: 12 * task.attempt }
        // the reference run's arguments without --quantMode TranscriptomeSAM and --quantTranscriptomeSAMoutput BanSingleEnd
        ext.args = { "--outSAMtype BAM Unsorted --outSAMattributes NH HI AS NM MD --readFilesCommand zcat --twopassMode Basic --runRNGseed 0 --outFilterMultimapNmax 20 --alignSJDBoverhangMin 1 --outSAMstrandField intronMotif ${params.star_extra_args}" }
        publishDir = [ path: { "${params.outdir}/qc/star" }, mode: 'copy', pattern: '*Log.final.out' ]
    }
    withName: 'SORT_NAME_THEN_POSITION' {
        ext.deterministic = { params.deterministic_sort }
        publishDir = [ path: { "${params.outdir}/run/intermediate" }, mode: 'copy', pattern: '*.sorted.bam{,.bai}', enabled: params.keep_bams ]
    }
    withName: 'UMICOLLAPSE' {
        ext.args   = { "--two-pass --algo '${params.dedup_algo}'" }
        ext.prefix = { "${meta.id}.umi_dedup.sorted" }
        publishDir = [
            [ path: { "${params.outdir}/qc/umicollapse" }, mode: 'copy', pattern: '*.log' ],
            [ path: { "${params.outdir}/run/intermediate" }, mode: 'copy', pattern: '*.bam', enabled: params.keep_bams ]
        ]
    }
    withName: 'SAMTOOLS_INDEX_DEDUP' {
        ext.prefix = { "${meta.id}.umi_dedup.sorted" }
        publishDir = [ path: { "${params.outdir}/run/intermediate" }, mode: 'copy', pattern: '*.bai', enabled: params.keep_bams ]
    }
    withName: 'SAMTOOLS_(STATS|FLAGSTAT|IDXSTATS)' {
        publishDir = [ path: { "${params.outdir}/qc/samtools" }, mode: 'copy' ]
    }
    withName: 'SAMTOOLS_(STATS|FLAGSTAT|IDXSTATS)_DEDUP' {
        ext.prefix = { "${meta.id}.umi_dedup.sorted.bam" }
    }
    // the 45S rRNA check: the main alignment's filters, without splicing (prototype on SRR33542394, 14 Nov 2026)
    withName: 'RRNA_CHECK' {
        ext.args   = '--runRNGseed 0 --alignIntronMax 1 --outFilterMultimapNmax 1000 --outFilterMismatchNoverLmax 0.1 --clip3pAdapterSeq AAAAAAAA'
    }
    withName: 'SUBREAD_FEATURECOUNTS' {
        ext.args   = '-B -C -g gene_biotype -t exon'
        publishDir = [ path: { "${params.outdir}/qc/biotype" }, mode: 'copy', pattern: '*.summary' ]
    }
    withName: 'CUSTOM_MULTIQCCUSTOMBIOTYPE' {
        publishDir = [ path: { "${params.outdir}/qc/biotype" }, mode: 'copy', pattern: '*.tsv' ]
    }
    withName: 'SAMTOOLS_SORT_QUALIMAP' {
        ext.args   = '-n'
        ext.prefix = { "${meta.id}.namesorted" }
    }
    withName: 'QUALIMAP_RNASEQ' {
        ext.args   = '--sorted'
        publishDir = [ path: { "${params.outdir}/qc/qualimap" }, mode: 'copy' ]
    }
    withName: 'RSEQC_.*' {
        publishDir = [ path: { "${params.outdir}/qc/rseqc" }, mode: 'copy' ]
    }
    withName: 'MULTIQC' {
        ext.prefix = 'multiqc_report'
        publishDir = [ path: { "${params.outdir}/qc" }, mode: 'copy', pattern: 'multiqc_report*' ]
    }
    withName: 'DUPRADAR' {
        publishDir = [ path: { "${params.outdir}/qc/dupradar" }, mode: 'copy' ]
    }
}
