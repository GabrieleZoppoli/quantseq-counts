// Release check, run C: other thread counts for the steps whose output order or content could follow them.
process {
    withName: 'STAR_ALIGN'              { cpus = 5 }
    withName: 'SORT_NAME_THEN_POSITION' { cpus = 3 }
    withName: 'FEATURECOUNTS_MAIN'      { cpus = 3 }
    withName: 'TRIMGALORE'              { cpus = 3 }
    withName: 'UMICOLLAPSE'             { cpus = 1 }
}
