// Container engines and the SLURM executor, chosen with -profile (written by quantseq-counts run).
profiles {
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        docker.enabled       = false
    }
    udocker {
        udocker.enabled = true
        docker.enabled  = false
    }
    docker {
        docker.enabled      = true
        docker.fixOwnership = true
    }
    slurm {
        process.executor = 'slurm'
    }
}
