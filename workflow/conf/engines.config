// Container engines and the SLURM executor, chosen with -profile (written by quantseq-counts run).
// Images named without a registry (biocontainers/...) are on quay.io, as nf-core sets it; udocker gets the same
// through UDOCKER_REGISTRY (src/quantseq_counts/launch.py).
docker.registry    = 'quay.io'
apptainer.registry = 'quay.io'
profiles {
    apptainer {
        includeConfig 'containers.config'
        apptainer.enabled    = true
        apptainer.autoMounts = true
        docker.enabled       = false
    }
    udocker {
        udocker.enabled = true
        docker.enabled  = false
    }
    docker {
        includeConfig 'containers.config'
        docker.enabled      = true
        docker.fixOwnership = true
    }
    slurm {
        process.executor = 'slurm'
    }
}
