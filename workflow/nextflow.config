// quantseq-counts workflow. Settings come from run/settings.yaml (-params-file); run/run.config adds the limits,
// the queue and the container mounts. Nothing here is meant to be edited by a user.
manifest {
    name            = 'quantseq-counts'
    description     = 'Reproducible gene counts and QC from QuantSeq 3\' mRNA-Seq FWD libraries'
    nextflowVersion = '25.04.8'
    license         = 'MIT'
}
// Defaults only for the settings read outside closures below; run/settings.yaml gives every setting.
params {
    outdir             = null
    keep_bams          = false
    keep_trimmed_fastq = false
}
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'
includeConfig 'conf/engines.config'

// The run's record: the trace (one line per task, with its container) and the resource report, in outdir/run/
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/run/trace.txt"
    fields    = 'task_id,hash,name,status,exit,container,cpus,memory,realtime,%cpu,peak_rss,workdir'
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/run/report.html"
}
